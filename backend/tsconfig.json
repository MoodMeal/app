{
  "compilerOptions": {
    /* Output paths */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Language and environment */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Types */
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    /* Output extras */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    /* Type checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    /* Module behavior */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}