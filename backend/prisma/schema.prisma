// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  chatSessions ChatSession[]
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  userId    Int
  title     String
  messages  ChatMessage[]
  dishes    Dish[]
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade) // <- cascade here
  sessionId Int
  role      String // "user" or "assistant"
  content   String
  createdAt DateTime    @default(now())
}

model Dish {
  id          Int         @id @default(autoincrement())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade) // <- cascade here
  sessionId   Int
  name        String
  cuisine     String?
  country     String?
  description String?
  reasoning   String?
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
